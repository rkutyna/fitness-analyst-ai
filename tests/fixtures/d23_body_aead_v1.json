{
  "$comment": [
    "D23 body AEAD, version 1. Cross-language vectors: the server",
    "publishes this file and the iOS client replays it. Generated by",
    "scripts/d23_reference.py, which is a SECOND implementation and",
    "imports nothing from health_advisor -- a vector file produced by",
    "the code it tests is an instrument whose green means unmeasured.",
    "Regenerate with: python scripts/d23_reference.py --out <this>",
    "No production secret appears here. The nonces are a fixed counter",
    "so the file is reproducible; the shipped sealer uses os.urandom",
    "and exposes an injectable nonce only to its tests."
  ],
  "version": 1,
  "algorithm": "AES-256-GCM",
  "kdf": "HKDF-SHA256",
  "hkdf_salt_b64": "aGEtZDIzLWJvZHktYWVhZC12MQ==",
  "info_request_b64": "aGEvZDIzL3YxL2JvZHkvcmVxdWVzdA==",
  "info_response_b64": "aGEvZDIzL3YxL2JvZHkvcmVzcG9uc2U=",
  "info_key_id_b64": "aGEvZDIzL3YxL2tleS1pZA==",
  "key_bytes": 32,
  "key_id_bytes": 8,
  "key_id_encoding": "base64url, unpadded",
  "nonce_bytes": 12,
  "tag_bytes": 16,
  "header_bytes": 21,
  "skew_window_seconds": 600,
  "skew_boundary": "inclusive: |now - timestamp| <= skew_window_seconds",
  "wire_layout": "version(1) || timestamp_ms(uint64 BE) || nonce(12) || ciphertext||tag(16)",
  "aad_b64_is": "the AAD THE SEALER USED, built from the case's own top-level direction/method/target/key_id/timestamp_ms. A verifier must BUILD ITS OWN from what it observes on the wire and from `verify_as` when present -- for a mutated or misdirected case the two differ, and that difference is the test.",
  "empty_body_rule": "the PRIMITIVE refuses empty bytes with d23_missing. The MIDDLEWARE never hands it a request that carries no body at all (a GET), and always seals the response. Conflating the two makes a stripped body look like a bodyless request.",
  "aad_layout": "version(1) || u32be(len)||direction || u32be(len)||method || u32be(len)||target || u32be(len)||key_id || u64be(timestamp_ms)",
  "target_rule": "raw percent-encoded path, plus '?' and the raw query bytes when the query string is non-empty; never the percent-decoded path, and never the path alone",
  "response_binding": "a response binds the method and target of the request it answers",
